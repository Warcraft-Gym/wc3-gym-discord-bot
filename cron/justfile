set shell := ["bash", "-euo", "pipefail", "-c"]

# Wrangler 4 needs Node 22; 3 runs on the Node 21 dev box and in CI alike
wrangler := "npx --yes wrangler@3.114.17"

# Run the Worker tests.
test:
    node --test

# Deploy the Worker, prod or staging. Its secret survives a deploy; set it in the dashboard.
deploy env="prod":
    {{ wrangler }} deploy {{ if env == "prod" { "" } else { "--env " + env } }}
