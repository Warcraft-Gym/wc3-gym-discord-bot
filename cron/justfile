set shell := ["bash", "-euo", "pipefail", "-c"]

# Wrangler 4 needs Node 22; 3 runs on the Node 21 dev box and in CI alike
wrangler := "npx --yes wrangler@3.114.17"

# Run the Worker tests.
test:
    node --test

# Deploy the Worker, prod or staging, and set its CRON_SECRET from the environment.
deploy env="prod":
    : "${CRON_SECRET:?CRON_SECRET is not set}"
    {{ wrangler }} deploy {{ if env == "prod" { "" } else { "--env " + env } }}
    printf %s "$CRON_SECRET" | {{ wrangler }} secret put CRON_SECRET {{ if env == "prod" { "" } else { "--env " + env } }}
