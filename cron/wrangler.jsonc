{
  "name": "wc3-gym-cast-reminders",
  "main": "index.js",
  "compatibility_date": "2026-09-09",
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "BACKEND_API_URL": "https://wc3-gym-backend-snowy.vercel.app" },
  // CLOUDFLARE_CRON_SECRET is a Worker secret, set once per Worker in the Cloudflare dashboard
  "observability": { "enabled": true },
  "env": {
    // Deploys as wc3-gym-cast-reminders-staging. No cron: `triggers` is an
    // inheritable key, so the empty list is what stops the prod schedule from
    // applying here. Run it on demand with `wrangler dev --test-scheduled`.
    "staging": {
      "triggers": { "crons": [] },
      "vars": { "BACKEND_API_URL": "https://wc3-gym-backend-git-staging-wc-3-gym.vercel.app" }
    }
  }
}
